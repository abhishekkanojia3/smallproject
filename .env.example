# TechRunniti Website Environment Variables
# Copy this file to .env.local and fill in your actual values

# Contact Information
NEXT_PUBLIC_WHATSAPP=919131590319
NEXT_PUBLIC_EMAIL=hello@techrunniti.com
NEXT_PUBLIC_PHONE=+91-9876543210

# API Endpoints
NEXT_PUBLIC_LAMBDA_ENDPOINT=https://api.example.com/contact
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# reCAPTCHA (Optional, for form protection)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
RECAPTCHA_SECRET=your_recaptcha_secret_key_here

# CORS (Lambda)
ALLOWED_ORIGINS=https://techrunniti.com,https://www.techrunniti.com

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=your_google_analytics_id_here

# Email Service
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@techrunniti.com

# Error Tracking (Optional, e.g., Sentry)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Environment
NODE_ENV=development
